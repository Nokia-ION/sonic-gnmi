{
  "title": "CPN openconfig-lacp get/set (interval+fallback write -> read-back -> CONFIG_DB validate)",
  "_comment": [
    "Tests which openconfig-lacp config writes actually persist on CPN.",
    "op1 seeds operational STATE_DB LAG_TABLE/LAG_MEMBER_TABLE (teamd creates these",
    "on a live switch) so the write's parent-table check passes.",
    "Only fields present in CPN sonic-portchannel.yang are written: interval->fast_rate",
    "and fallback. (system-id-mac/system-priority/lacp-mode map to DB fields the CPN",
    "YANG does not define, so CVL rejects them.)"
  ],
  "operations": [
    {
      "title": "GET config/fallback (default false) + seed operational STATE_DB LAG tables",
      "operation": "get",
      "returnCode": 0,
      "xpath": "/openconfig-lacp:lacp/interfaces/interface[name=PortChannel1]/config/fallback",
      "target": "OC_YANG",
      "type": "object",
      "required": [
        "openconfig-lacp:fallback"
      ],
      "properties": {
        "openconfig-lacp:fallback": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      },
      "subOpers": [
        {
          "oper": "dbHSet",
          "title": "seed STATE_DB LAG_TABLE + LAG_MEMBER_TABLE (operational, teamd-created on a switch)",
          "db": "STATE_DB",
          "value": {
            "LAG_TABLE|PortChannel1": {
              "oper_status": "up"
            },
            "LAG_MEMBER_TABLE|PortChannel1|Ethernet0": {
              "status": "enabled"
            }
          }
        }
      ]
    },
    {
      "title": "SET lacp config container (interval=SLOW, fallback=true)",
      "operation": "update",
      "returnCode": 0,
      "xpath": "/openconfig-lacp:lacp/interfaces/interface[name=PortChannel1]/config",
      "target": "OC_YANG",
      "attributeData": "{\"openconfig-lacp:config\":{\"interval\":\"SLOW\",\"fallback\":true}}"
    },
    {
      "title": "GET config/interval back, verify SLOW persisted (set->get round trip)",
      "operation": "get",
      "returnCode": 0,
      "xpath": "/openconfig-lacp:lacp/interfaces/interface[name=PortChannel1]/config/interval",
      "target": "OC_YANG",
      "type": "object",
      "required": [
        "openconfig-lacp:interval"
      ],
      "properties": {
        "openconfig-lacp:interval": {
          "type": "string",
          "enum": [
            "SLOW"
          ]
        }
      }
    },
    {
      "title": "GET config/fallback back (=true) + confirm gNMI SET persisted to CONFIG_DB PORTCHANNEL",
      "operation": "get",
      "returnCode": 0,
      "xpath": "/openconfig-lacp:lacp/interfaces/interface[name=PortChannel1]/config/fallback",
      "target": "OC_YANG",
      "type": "object",
      "required": [
        "openconfig-lacp:fallback"
      ],
      "properties": {
        "openconfig-lacp:fallback": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "subOpers": [
        {
          "oper": "dbHGetValidate",
          "title": "confirm the gNMI SET wrote CONFIG_DB PORTCHANNEL fast_rate + fallback",
          "db": "CONFIG_DB",
          "value": {
            "PORTCHANNEL|PortChannel1": {
              "fast_rate": "false",
              "fallback": "true"
            }
          }
        }
      ]
    }
  ]
}
